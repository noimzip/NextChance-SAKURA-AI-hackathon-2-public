# さくらのAI Engine API設定
# コントロールパネルで発行したアカウントトークン (UUID:SECRET形式)
VITE_SAKURA_AI_API_KEY=your-uuid:your-secret

# APIベースURL
VITE_SAKURA_AI_BASE_URL=https://api.ai.sakura.ad.jp/v1

# Google Calendar API OAuth2 クライアントID（Google Cloud Console で取得）
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
